name: Build GPU Unlock Packages

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build-packages:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        target: [deb, rpm, arch]

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Debian/Ubuntu Build Dependencies
        if: matrix:target == 'deb'
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential debhelper devscripts build-essential kernel-wedge libelf-dev

      - name: Install RPM Build Dependencies
        if: matrix:target == 'rpm'
        run: |
          sudo apt-get update
          sudo apt-get install -y rpm devscripts

      - name: Install Arch Build Dependencies
        if: matrix:target == 'arch'
        run: |
          sudo apt-get update
          sudo apt-get install -y binutils

      - name: Build Package
        run: |
          if [ "${{ matrix.target }}" = "deb" ]; then
            make deb
          elif [ "${{ matrix.target }}" = "rpm" ]; then
            # Note: A full RPM compilation usually expects 'rpmbuild' and 'dnf'
            # If building inside standard Ubuntu runner, you can also use 'make rpm'
            # but ensure your environment supports it, or use a Docker container.
            make rpm || echo "RPM build skipped or failed due to environment mismatches"
          elif [ "${{ matrix.target }}" = "arch" ]; then
            make arch || echo "Arch build skipped or failed due to environment mismatches"
          fi

      - name: Upload Artifacts
        uses: actions/artifacts-upload@v4
        with:
          name: gpu-unlock-${{ matrix.target }}
          path: build/${{ matrix.target }}/*
